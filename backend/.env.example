# StudyBuddy AI — backend environment template
#
# Copy this file to `.env` in the same directory and fill in the blanks:
#   cp backend/.env.example backend/.env
#
# `.env` is gitignored and must never be committed. Every key below is optional
# unless marked REQUIRED — the code falls back to a safe default for the rest.
# The full reference table (what each key does, its default, and what breaks
# without it) lives in docs/getting-started.md.

# ── REQUIRED ────────────────────────────────────────────────────────────────
# Groq key — every answer is generated by Groq. Free tier: console.groq.com
GROQ_API_KEY=gsk_your_actual_groq_api_key_here
# Gemini key — document embeddings for RAG. Free tier: aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Model, prices and limits ────────────────────────────────────────────────
# The model is account-scoped: if a call fails with model_not_found, list what
# your key can use at https://api.groq.com/openai/v1/models and change this.
GROQ_MODEL=openai/gpt-oss-120b
# USD per million tokens for GROQ_MODEL. Left unset, /api/usage/ still records
# real token counts but reports a cost of 0.0000 instead of a guessed rate.
GROQ_PRICE_PER_M_INPUT=0
GROQ_PRICE_PER_M_OUTPUT=0
# Per-user daily token budget (input + output across every tool and streamed
# chat). Requests are refused with 429 once spent; resets at midnight UTC.
# Set to 0 to disable the cap.
USER_TOKEN_LIMIT=10000
# Per-scope rate-limit ceilings (defaults shown). "generate" / "rag" / "chat"
# scope the heaviest endpoints separately from the anon and user baselines.
THROTTLE_ANON_RATE=60/hour
THROTTLE_USER_RATE=300/hour
THROTTLE_GENERATE_RATE=60/hour
THROTTLE_RAG_RATE=40/hour
THROTTLE_CHAT_RATE=90/hour

# ── Database ────────────────────────────────────────────────────────────────
# Omit DATABASE_URL for local development: settings fall back to
# backend/db.sqlite3. Any Postgres URL is forced onto TLS by default.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Set this only for a local Postgres built without SSL. sqlite URLs ignore the
# option entirely (their driver rejects connection options), so it stays
# commented here.
# DB_SSL_REQUIRE=false

# ── Scraping ────────────────────────────────────────────────────────────────
# Optional — clean URL scraping via Firecrawl; without it the built-in
# requests/BeautifulSoup scraper is used, and any Firecrawl failure falls
# back to it automatically.
FIRECRAWL_API_KEY=fc_your_firecrawl_api_key_here
# Optional — comma-separated hostname allowlist for URL scraping. Matching is
# suffix-based, so "edu" admits mit.edu and cs.mit.edu. Left unset, scrapes are
# still gated by the built-in SSRF checks and domain blocklist.
ALLOWED_SCRAPE_DOMAINS=

# ── RAG tunables (defaults shown) ───────────────────────────────────────────
# Changing RAG_EMBED_MODEL or RAG_EMBED_DIMENSIONS requires re-indexing every
# uploaded document (python manage.py reindex_documents).
RAG_EMBED_MODEL=gemini-embedding-2
RAG_EMBED_DIMENSIONS=768
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MAX_UPLOAD_MB=20
# Library caps per account (0 disables a check).
RAG_MAX_DOCUMENTS_PER_USER=25
RAG_MAX_CHUNKS_PER_DOCUMENT=2000
RAG_MAX_CHUNKS_PER_USER=10000

# ── Django ──────────────────────────────────────────────────────────────────
# Any long random string of 32+ characters. Required whenever DEBUG is off (the
# Docker stack forces it off): the server refuses to start on the example value.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=some-long-random-secret-key
# Local development only. The code default is False, because a deployment that
# leaves DEBUG on answers failed requests with tracebacks that dump settings.
DEBUG=True

# ── Signup notification email (optional, local-only in practice) ────────────
# The notification is sent inside the signup request, so this bounds how long
# an unresponsive SMTP host can stall it. Defaults to 5 seconds; without it the
# socket blocks on the OS TCP timeout (21 s on Windows, minutes on Linux).
#
# Signup notifications stay disabled while SIGNUP_NOTIFICATION_EMAIL is empty —
# filling it is the only switch. A deployed Render free instance cannot deliver
# at all: ports 25/465/587 are blocked there. For Gmail: EMAIL_HOST=smtp.gmail.com,
# a 16-character App Password (Google account -> Security -> 2-Step Verification ->
# App passwords) in EMAIL_HOST_PASSWORD, and DEFAULT_FROM_EMAIL must equal
# EMAIL_HOST_USER or Gmail rejects the send. A normal Google password will not
# work over SMTP.
SIGNUP_NOTIFICATION_EMAIL=
DEFAULT_FROM_EMAIL=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=5

# ── Error tracking (optional) ───────────────────────────────────────────────
# GlitchTip (Sentry-compatible) DSN. Leave empty to disable error tracking.
GLITCHTIP_DSN=
